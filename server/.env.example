# 服务端口
PORT=8199
NODE_ENV=development

# 跨域白名单（逗号分隔）：admin / web / 小程序调试
CORS_ORIGINS=http://localhost:5178,http://localhost:5199,http://127.0.0.1:5178,http://127.0.0.1:5199

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=aisock
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=
WX_SECRET=

# 微信支付（可选）
WXPAY_MCHID=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_SERIAL=
WXPAY_APIV3_KEY=

# 支付宝（可选；注意：server/ 当前未实现支付宝下单/回调，配置仅占位）
ALIPAY_APPID=
ALIPAY_MERCHANT_PRIVATE_KEY_PATH=
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_NOTIFY_URL=

# 对象存储 OSS（可选；ASR 语音输入依赖公网可达音频地址，强烈建议生产开启）
# 注意：以下 4 项需全部填写 OSS 才会启用，否则回退本地磁盘
OSS_BUCKET=
OSS_ENDPOINT=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=
# CDN 加速域名（可选）；未配置时用 https://{bucket}.{endpoint}/{key} 访问
OSS_CDN_DOMAIN=

# 文件上传（本地磁盘）
UPLOAD_DIR=
UPLOAD_BASE_URL=

# 短信（可选，开发期验证码固定 1234）
SMS_PROVIDER=dev
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# ── 通义千问 / 阿里云百炼 DashScope（统一 key：文本优化 qwen / 文生图万相 wan / 语音识别 qwen3-asr）──
# 一个 key 通吃文本、文生图、ASR。模型名在「后台 → AI 配置」里可改，无需改代码。
DASHSCOPE_API_KEY=sk-5bf2c2cde80642bb9b9262ef9ac60638
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com

# AI 文本（提示词优化）：默认走 DashScope 千问（OpenAI 兼容端点）。
# 留空 AI_TEXT_API_KEY 时回退用 DASHSCOPE_API_KEY。AI_TEXT_MODEL 后台可覆盖。
AI_TEXT_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_TEXT_API_KEY=
AI_TEXT_MODEL=qwen-plus
# AI 文生图：留空则走 DashScope 万相（provider=dashscope，模型后台可配）；
# 也可填 KIE/通用接口地址走原通道。
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
