# 服务端口
PORT=8199
NODE_ENV=development

# 跨域白名单（逗号分隔）：admin / web / 小程序调试
CORS_ORIGINS=http://localhost:5178,http://localhost:5199,http://127.0.0.1:5178,http://127.0.0.1:5199

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root123
DB_NAME=aisock
DB_POOL_SIZE=20

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# 微信小程序
WX_APPID=
WX_SECRET=

# 微信支付（可选）
WXPAY_MCHID=
WXPAY_PRIVATE_KEY_PATH=
WXPAY_SERIAL=
WXPAY_APIV3_KEY=

# 对象存储（可选）
OSS_REGION=
OSS_BUCKET=
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# 短信（可选，开发期验证码固定 1234）
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# AI 文/图生图接口（可选）
AI_TEXT_API_URL=
AI_TEXT_API_KEY=
AI_IMAGE_API_URL=
AI_IMAGE_API_KEY=
