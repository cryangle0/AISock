{
  "name": "aisock-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "爱花型 · AI 袜版设计系统 - 后端服务（Hono + TS + MySQL + Redis）",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
